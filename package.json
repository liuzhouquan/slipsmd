{
  "name": "slipsmd",
  "version": "0.1.0-alpha.5",
  "description": "A quiet Markdown workspace. Capture first, connect later.",
  "private": true,
  "license": "MIT",
  "author": "liuzhouquan",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && node scripts/licenses.mjs && electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop.mjs",
    "preview": "electron-vite preview",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux --publish never",
    "format": "prettier --write src scripts test \"*.ts\" \"*.json\" \"*.yml\" \".github/**/*.yml\"",
    "format:check": "prettier --check src scripts test \"*.ts\" \"*.json\" \"*.yml\" \".github/**/*.yml\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "chokidar": "^5.0.0",
    "katex": "^0.19.1",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.0",
    "write-file-atomic": "^7.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^24.0.0",
    "@types/write-file-atomic": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "45.5.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.58.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
